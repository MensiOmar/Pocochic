{
  "name": "@pocochic/admin-api",
  "version": "0.0.0",
  "private": true,
  "description": "Admin Hono API (Cloudflare Worker) for POCOCHIC",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:generate": "npm run db:generate --workspace=@pocochic/db",
    "db:migrate": "npm run db:migrate --workspace=@pocochic/db",
    "build": "wrangler deploy --dry-run",
    "test": "echo 'tests for admin-api'"
  },
  "dependencies": {
    "hono": "4.6.8",
    "@pocochic/db": "workspace:*"
  },
  "devDependencies": {
    "wrangler": "3.78.0",
    "@cloudflare/workers-types": "4.20240925.0"
  }
}
