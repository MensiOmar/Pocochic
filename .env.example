# POCOCHIC — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# --- Database ---
# Local SQLite file. Path is relative to the pocochic/ product root.
DATABASE_URL=sqlite://./data/pocochic.db

# --- MinIO (Local Object Storage) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=pocochic-catalog
MINIO_REGION=us-east-1

# --- Shop alert email (Resend via fetch, no SDK) ---
# From stays onboarding@resend.dev until the POCOCHIC domain is verified in Resend.
RESEND_API_KEY=
SHOP_ALERT_EMAIL=pocochicaccessories@gmail.com
SHOP_ALERT_FROM=onboarding@resend.dev

# --- Origins ---
SHOP_WEB_ORIGIN=http://localhost:5173
ADMIN_WEB_ORIGIN=http://localhost:5174
SHOP_API_PORT=8787
ADMIN_API_PORT=8788

# --- Admin session (A1) ---
# Owner generates a long random secret. Login is rejected if this is shorter than 16 characters.
ADMIN_SESSION_SECRET=omarchaima

# --- App ---
NODE_ENV=development
