# POCOCHIC — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# --- Database ---
# Local SQLite connection string for development
# NOTE: ./data is relative to pocochic/ product root (cd pocochic before sourcing, or use full path / abs in some contexts)
DATABASE_URL=sqlite://./data/pocochic.db

# --- MinIO (Local Object Storage) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=pocochic-assets
MINIO_REGION=us-east-1

# --- App ---
NODE_ENV=development
PORT=3000
